CREATE TABLE TransactionEntity (
    id TEXT PRIMARY KEY NOT NULL,
    userId TEXT NOT NULL,
    accountId TEXT NOT NULL,
    destinationAccountId TEXT,
    type TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'INR',
    baseAmountMinorUnits INTEGER NOT NULL,
    baseCurrency TEXT NOT NULL DEFAULT 'INR',
    exchangeRate REAL NOT NULL DEFAULT 1.0,
    categoryId TEXT NOT NULL DEFAULT '',
    description TEXT NOT NULL,
    notes TEXT NOT NULL DEFAULT '',
    tags TEXT NOT NULL DEFAULT '',
    date INTEGER NOT NULL,
    isRecurring INTEGER NOT NULL DEFAULT 0,
    recurringRuleId TEXT,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER,
    version INTEGER NOT NULL DEFAULT 1,
    syncStatus TEXT NOT NULL DEFAULT 'SYNCED'
);

selectAllTransactions:
SELECT * FROM TransactionEntity WHERE deletedAt IS NULL ORDER BY date DESC LIMIT :limit;

selectTransactionsByAccount:
SELECT * FROM TransactionEntity WHERE (accountId = :accountId OR destinationAccountId = :accountId) AND deletedAt IS NULL ORDER BY date DESC;

selectTransactionsByDateRange:
SELECT * FROM TransactionEntity WHERE date >= :startDate AND date <= :endDate AND deletedAt IS NULL ORDER BY date DESC;

selectTransactionById:
SELECT * FROM TransactionEntity WHERE id = :id AND deletedAt IS NULL LIMIT 1;

insertTransaction:
INSERT OR REPLACE INTO TransactionEntity (
    id, userId, accountId, destinationAccountId, type, amountMinorUnits, currency,
    baseAmountMinorUnits, baseCurrency, exchangeRate, categoryId, description, notes,
    tags, date, isRecurring, recurringRuleId, createdAt, updatedAt, deletedAt, version, syncStatus
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

softDeleteTransaction:
UPDATE TransactionEntity SET deletedAt = :deletedAt, updatedAt = :updatedAt, syncStatus = 'PENDING_DELETE' WHERE id = :id;

searchTransactions:
SELECT * FROM TransactionEntity
WHERE deletedAt IS NULL AND (description LIKE '%' || :query || '%' OR notes LIKE '%' || :query || '%' OR tags LIKE '%' || :query || '%')
ORDER BY date DESC LIMIT 50;
