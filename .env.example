# -----------------------------------------------------------------------------
# FinPilot 2.0 — Environment Variables Template
# Copy this file to .env and provide your specific credentials.
# NEVER commit .env to version control!
# -----------------------------------------------------------------------------

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini AI Configuration (Server-Side ONLY)
# Obtain from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth & Google Sheets API Integration
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/sheets/callback

# Firebase Admin SDK Configuration (Optional: Path to service account json)
FIREBASE_PROJECT_ID=expense-tracker-f9567
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@expense-tracker-f9567.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Client Configuration
FINPILOT_BACKEND_URL=http://localhost:5000/api
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
