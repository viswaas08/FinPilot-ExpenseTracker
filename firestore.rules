rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and private financial data collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Financial Accounts subcollection
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      // Savings Goals subcollection
      match /savings_goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // Subscriptions & Recurring Transactions subcollection
      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }

      // Custom Categories subcollection
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // Sync Mutation Queue
      match /sync_queue/{queueId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
